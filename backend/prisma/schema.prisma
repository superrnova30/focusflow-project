generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

model User {
  id                     String        @id @default(cuid())
  email                  String        @unique
  passwordHash           String
  emailVerified          Boolean       @default(false)
  emailVerificationCode  String?
  emailVerificationExpires DateTime?
  passwordResetCodeHash  String?
  passwordResetExpires   DateTime?
  passwordResetAttempts  Int           @default(0)
  name                   String
  role                   Role          @default(STUDENT)
  status                 AccountStatus @default(ACTIVE)
  profilePicture         String?
  studentId              String?
  course                 String?
  school                 String?
  yearLevel              String?
  section                String?
  studyGoals             String?
  preferredStudyDuration Int?
  dailyGoalMinutes       Int           @default(120)
  focusMinutes           Int           @default(25)
  shortBreakMinutes      Int           @default(5)
  longBreakMinutes       Int           @default(15)
  sessionsBeforeLongBreak Int          @default(4)
  remindersEnabled       Boolean       @default(true)
  reminderTime           String        @default("18:00")
  timezone               String        @default("UTC")

  // Gamification (XP + Hearts)
  xp                    Int           @default(0)
  hearts                Int           @default(5)
  hints                 Int           @default(3)
  bonusHints            Int           @default(0)
  coins                 Int           @default(0)
  streakRewardLevel     Int           @default(0)
  heartsDepletedAt      DateTime?
  memorizeSettings      Json?
  dailyUsageDate        String?
  dailyPromptsUsed      Int           @default(0)
  dailyChatUsed         Int           @default(0)
  dailyTutorUsed        Int           @default(0)
  correctAnswers        Int           @default(0)
  wrongAnswers          Int           @default(0)
  answerCombo           Int           @default(0)
  totalXpEarned         Int           @default(0)

  // Go Unlimited subscription. `premiumUntil` is the authoritative expiry the
  // server checks; null means the student has never subscribed. `isPremium` is
  // a denormalized convenience flag kept in sync on every grant/revoke.
  isPremium             Boolean       @default(false)
  premiumPlan           String?       // "unlimited"
  premiumSince          DateTime?
  premiumUntil          DateTime?

  // Gamification polish — streaks, levels, challenges
  streakCount           Int           @default(0)
  longestStreak         Int           @default(0)
  lastActiveDate        String?       // "YYYY-MM-DD"
  currentLevel          Int           @default(1)
  challengesCompleted   Int           @default(0)

  createdAt              DateTime      @default(now())
  lastActiveAt           DateTime?

  tasks             Task[]
  subjects          Subject[]
  sessions          PomodoroSession[]
  materialsUploaded StudyMaterial[]   @relation("UploadedBy")
  quizzesCreated    Quiz[]            @relation("QuizCreatedBy")
  quizAttempts      QuizAttempt[]
  quizAssignments   QuizAssignment[]
  activityLogs      ActivityLog[]
  flashcardCollections FlashcardCollection[]
  deckStudyProgress    DeckStudyProgress[]
  notes             StudyNote[]
  deviceTokens      DeviceToken[]
  challengeCompletions DailyChallengeCompletion[]
  coachInsights     CoachInsight[]   @relation("CoachInsightOwner")
  coachInsightsGenerated CoachInsight[] @relation("CoachInsightGeneratedBy")
  chatConversations ChatConversation[]
  payments          Payment[]
  subscription      Subscription?
  following         Follow[]           @relation("UserFollowing")
  followers         Follow[]           @relation("UserFollowers")
  profileActivities ProfileActivity[]
  activityReactions ActivityReaction[]
  notifications     Notification[]
  actedNotifications Notification[]    @relation("NotificationActor")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  type      String
  title     String
  body      String?
  data      Json?
  readAt    DateTime?
  dedupeKey String
  createdAt DateTime @default(now())

  @@unique([userId, type, dedupeKey])
  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model ProfileActivity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  dedupeKey String
  meta      Json?
  createdAt DateTime @default(now())
  reactions ActivityReaction[]

  @@unique([userId, type, dedupeKey])
  @@index([userId, createdAt])
}

model ActivityReaction {
  id         String          @id @default(cuid())
  activityId String
  activity   ProfileActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())

  @@unique([activityId, userId])
  @@index([activityId])
}

model Subject {
  id         String    @id @default(cuid())
  name       String
  ownerId    String
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  archived   Boolean   @default(false)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  tasks     Task[]
  sessions  PomodoroSession[]
  materials StudyMaterial[]

  @@index([ownerId])
}

model Task {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId      String?
  subject        Subject? @relation(fields: [subjectId], references: [id])
  title          String
  descriptionJson Json?
  estMinutes     Int      @default(25)
  completed      Boolean  @default(false)
  archived       Boolean  @default(false)
  archivedAt     DateTime?
  pomodorosSpent Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([userId, archived])
}

model PomodoroSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id])
  taskId    String?
  type      String // "focus" | "short" | "long"
  minutes   Int
  startedAt DateTime @default(now())

  @@index([userId, startedAt])
}

model StudyMaterial {
  id            String   @id @default(cuid())
  title         String
  subjectId     String?
  subject       Subject? @relation(fields: [subjectId], references: [id])
  uploadedById  String
  uploadedBy    User     @relation("UploadedBy", fields: [uploadedById], references: [id], onDelete: Cascade)
  fileUrl       String?
  fileType      String // "pdf" | "pptx" | "docx" | "txt"
  rawText       String?  @db.Text
  archived      Boolean  @default(false)
aiSummary            String?  @db.Text
  aiKeyConcepts        Json?
  aiLearningObjectives Json?
  aiImportantTerms     Json?
  aiShortAnswer        Json?
  aiPracticeQuestions  Json?
  createdAt            DateTime @default(now())

  flashcards Flashcard[]
  quizzes    Quiz[]

  @@index([uploadedById])
}

model FlashcardCollection {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String      @default("violet")
  isPublic  Boolean     @default(false)
  createdAt DateTime    @default(now())

  flashcards    Flashcard[]
  studyProgress DeckStudyProgress[]

  @@index([userId])
  @@index([userId, isPublic])
}

model DeckStudyProgress {
  id               String              @id @default(cuid())
  userId           String
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectionId     String
  collection       FlashcardCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  practiceAnswered Int                 @default(0)
  practiceUnlocked Boolean             @default(false)
  memorizeSessions Int                 @default(0)
  tutorCompleted   Boolean             @default(false)
  updatedAt        DateTime            @updatedAt

  @@unique([userId, collectionId])
  @@index([userId])
}

model Flashcard {
  id           String              @id @default(cuid())
  materialId   String?
  material     StudyMaterial?      @relation(fields: [materialId], references: [id], onDelete: Cascade)
  collectionId String?
  collection   FlashcardCollection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  front        String
  back         String

  @@index([collectionId])
  @@index([materialId])
}

model Quiz {
  id            String   @id @default(cuid())
  materialId    String?
  material      StudyMaterial? @relation(fields: [materialId], references: [id], onDelete: Cascade)
  createdById   String
  createdBy     User     @relation("QuizCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  title         String
  isPublished   Boolean  @default(false)
  createdAt     DateTime @default(now())

  questions   QuizQuestion[]
  attempts    QuizAttempt[]
  assignments QuizAssignment[]
}

model QuizQuestion {
  id       String @id @default(cuid())
  quizId   String
  quiz     Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type     String // "mcq" | "true_false" | "identification" | "short_answer"
  question String
  options  Json?
  answer   String
  order    Int    @default(0)
}

model QuizAssignment {
  id        String    @id @default(cuid())
  quizId    String
  quiz      Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId String
  student   User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  dueAt     DateTime?
  createdAt DateTime  @default(now())

  @@unique([quizId, studentId])
}

model StudyNote {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  contentJson Json     // rich text blocks
  source      String   @default("manual") // "ai" | "manual"
  isPublic    Boolean  @default(false)
  aiSummary       String?  @db.Text
  aiKeyConcepts   Json?
  aiImportantTerms Json?
  aiStudyTips     Json?
  aiLearningObjectives Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([userId, isPublic])
}

model QuizAttempt {
  id      String   @id @default(cuid())
  quizId  String
  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score   Int
  total   Int
  takenAt DateTime @default(now())

  @@index([userId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model DeviceToken {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token           String   @unique
  platform        String   @default("unknown") // "ios" | "android"
  timezone        String   @default("UTC")
  lastReminderKey String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

// AI Coach insights. A student can generate their own; admins can also generate
// one on a student's behalf (generatedById records who triggered it). Storing
// them keeps the user and admin sides in sync and gives admins an audit trail.
model CoachInsight {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("CoachInsightOwner", fields: [userId], references: [id], onDelete: Cascade)
  summary       String?  @db.Text
  data          Json     // the full generated insight object
  generatedById String?
  generatedBy   User?    @relation("CoachInsightGeneratedBy", fields: [generatedById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
}

// Persisted AI chat history. A conversation groups the messages exchanged
// between a student and the AI assistant so it can be browsed, searched and
// resumed later from the History screen. Title/intent are derived on the
// server so the list stays readable even for long first messages.
model ChatConversation {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  intent       String   @default("other") // "casual" | "study" | "other"
  messageCount Int      @default(0)
  preview      String?  @db.Text
  pinned       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  messages ChatMessage[]

  @@index([userId, updatedAt])
  @@index([userId, pinned])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // "user" | "assistant"
  content        String           @db.Text
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}

// One row per Xendit checkout attempt. An account is only upgraded after the
// server independently verifies the paid status with Xendit — never from a
// client-reported success.
model Payment {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String   @default("xendit")
  plan           String   @default("unlimited")
  amount         Int
  currency       String   @default("PHP")
  status         String   @default("PENDING") // PENDING | PAID | EXPIRED | FAILED
  // Xendit identifiers + the hosted checkout URL the client opens.
  externalId     String   @unique // our idempotency key, also sent to Xendit
  xenditInvoiceId String? @unique
  checkoutUrl    String?  @db.Text
  paymentMethod  String?
  paidAt         DateTime?
  expiresAt      DateTime?
  rawPayload     Json?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([userId, createdAt])
  @@index([status])
}

// The student's active/last subscription. Kept separate from User so the
// premium lifecycle (renewals, cancellations, expiry) has its own audit trail.
model Subscription {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan       String   @default("unlimited")
  status     String   @default("ACTIVE") // ACTIVE | EXPIRED | CANCELLED
  startedAt  DateTime @default(now())
  expiresAt  DateTime?
  autoRenew  Boolean  @default(false)
  lastPaymentId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([status])
}

model DailyChallenge {
  id           String   @id @default(cuid())
  date         String   @unique // "YYYY-MM-DD"
  title        String
  description  String
  xpReward     Int      @default(100)
  targetValue  Int      @default(1)
  metric       String   @default("quiz_correct") // "quiz_correct" | "focus_minutes" | "cards_reviewed" | "login"
  createdAt    DateTime @default(now())

  completions DailyChallengeCompletion[]
}

model DailyChallengeCompletion {
  id          String         @id @default(cuid())
  challengeId String
  challenge   DailyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())

  @@unique([challengeId, userId])
}

model SystemSettings {
  id               Int     @id @default(1)
  maintenanceMode  Boolean @default(false)
  allowSignups     Boolean @default(true)
  defaultDailyGoal Int     @default(120)
}
