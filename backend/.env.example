# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example local: postgresql://postgres:postgres@localhost:5432/focusflow?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/focusflow?schema=public"

# JWT secret — use any long random string
JWT_SECRET="change-me-to-a-long-random-string"

# Optional: token expiry (defaults to 7d)
# JWT_EXPIRES_IN="7d"

# AI provider keys for study packs, flashcards, quizzes, and coach responses
# Use either Gemini or OpenAI. Gemini is the default provider for this project.
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# Optional fallback: OpenAI key if you want to keep the legacy provider available
# OPENAI_API_KEY="sk-your-api-key-here"

# Optional Gemini model override (defaults to gemini-3.6-flash)
# GEMINI_MODEL="gemini-3.6-flash"

# Optional low-latency model used only for interactive chat
# GEMINI_CHAT_MODEL="gemini-flash-lite-latest"

# Optional CORS origin — defaults to "*"
# CORS_ORIGIN="http://localhost:8081"

# Optional server port — defaults to 4000
# PORT=4000

# Timezone-aware background reminder scheduler (enabled by default).
# Sends Expo remote push to users with pushNotificationsEnabled=true,
# remindersEnabled=true, and at least one DeviceToken. Runs every minute.
# Set false on additional API instances when using a dedicated scheduler.
# ENABLE_REMINDERS=true
#
# Mobile setup notes (no server env vars required for Expo Push Service):
# 1) Apply migration 20261017180000_push_notifications_enabled
# 2) For remote push on real devices: create an EAS project (`eas init`),
#    set expo.extra.eas.projectId in mobile/app.json, then build a
#    development/production client (Expo Go cannot receive remote push on SDK 54).
# 3) Expo Go still supports local scheduled daily reminders via the Settings toggle.

# ---- Email delivery (verification + password reset) ----
# Option A: Resend (recommended for production)
# RESEND_API_KEY="re_..."
# EMAIL_FROM="FocusFlow <noreply@yourdomain.com>"

# Option B: Gmail / SMTP
# EMAIL_USER="your@gmail.com"
# EMAIL_APP_PASSWORD="your-gmail-app-password"

# Option C: Generic SMTP
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="smtp-user"
# SMTP_PASS="smtp-password"
# EMAIL_FROM="FocusFlow <noreply@yourdomain.com>"

# Inbox address for Contact PomodAI ticket notifications (server-side only).
# SUPPORT_EMAIL="support@yourdomain.com"

# ---- Xendit payments (Go Unlimited + Shop Coins / GCash) ----
# One Xendit Invoice integration powers BOTH:
#   - POST /api/premium/checkout  → Go Unlimited subscription
#   - POST /api/shop/coins/checkout → coin packs
# Paid invoices are settled by the shared webhook + client verify endpoints.
#
# Setup checklist:
# 1) Xendit Dashboard → Developers → API Keys → copy Secret key
# 2) Settings → Payment Methods → enable GCash (and others you want) for Invoices
# 3) Settings → Webhooks → Invoices → URL:
#      https://YOUR-PUBLIC-HTTPS-HOST/api/premium/webhook
#    (use ngrok/cloudflared for local: https://xxxx.ngrok.io/api/premium/webhook)
#    Copy the Callback verification token into XENDIT_CALLBACK_TOKEN below.
# 4) Paste keys below, set XENDIT_SANDBOX=false (or omit it), restart the API.
# 5) In Test Mode, open checkout → choose GCash → tap “Simulate payment”.
#
# SECRET key (Developers → API Keys → Secret key).
# Must start with xnd_development_ (test) or xnd_production_ (live).
# Do NOT use the Public API key (xnd_public_…) here.
XENDIT_SECRET_KEY="xnd_development_your_secret_key_here"
# Callback verification token (Settings → Webhooks). Required to accept webhooks.
XENDIT_CALLBACK_TOKEN="your-xendit-callback-token"
# Optional overrides
# XENDIT_API_URL="https://api.xendit.co"
# XENDIT_CHECKOUT_BASE="https://checkout.xendit.co/web"
# PREMIUM_PRICE_PHP=299
# PREMIUM_DURATION_DAYS=30
# Optional coin pack prices (PHP). Defaults: 50→29, 150→79, 400→189
# COIN_PACK_50_PHP=29
# COIN_PACK_150_PHP=79
# COIN_PACK_400_PHP=189
# Redirect URLs after hosted checkout (deep links or web). Defaults use FRONTEND_URL.
# PREMIUM_SUCCESS_URL=focusflow://premium/return?status=success
# PREMIUM_FAILURE_URL=focusflow://premium/return?status=failed
# SHOP_SUCCESS_URL=focusflow://shop/return?status=success
# SHOP_FAILURE_URL=focusflow://shop/return?status=failed
# FRONTEND_URL=http://localhost:19006
# Restrict invoice methods (must be enabled on your Xendit account). GCash example:
XENDIT_INVOICE_PAYMENT_METHODS=GCASH,GRABPAY,PAYMAYA,CREDIT_CARD
# XENDIT_INVOICE_DURATION_SECONDS=86400
# Local-only fake checkout when NO real secret key is set. Never use in production.
# XENDIT_SANDBOX=true
# Webhook URL (Invoices product) — one URL settles both premium and coin packs:
#   https://YOUR-TUNNEL/api/premium/webhook

