# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example local: postgresql://postgres:postgres@localhost:5432/focusflow?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/focusflow?schema=public"

# JWT secret — use any long random string
JWT_SECRET="change-me-to-a-long-random-string"

# Optional: token expiry (defaults to 7d)
# JWT_EXPIRES_IN="7d"

# Anthropic API key for AI features (study packs + coach)
# Get one at https://console.anthropic.com/
OPENAI_API_KEY="sk-your-api-key-here"

# Optional CORS origin — defaults to "*"
# CORS_ORIGIN="http://localhost:8081"

# Optional server port — defaults to 4000
# PORT=4000

