# Copy this file to .env and fill in real values. Never commit .env itself.

# PostgreSQL connection string
# Local example: postgresql://postgres:postgres@localhost:5432/focusflow
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/focusflow"

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET="super-secret-example-key-12345"

# How long login sessions last
JWT_EXPIRES_IN="7d"

# Anthropic API key — used for AI quiz/flashcard/summary generation
ANTHROPIC_API_KEY="sk-ant-example"

# Port the API listens on
PORT=4000

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN="*"
